# Copy to .env.local for local development. Never commit real values.

# --- Site --------------------------------------------------------------------

# Absolute origin the site is served from. Used for canonical URLs, sitemap,
# Open Graph images and Stripe redirect targets.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: the code Google Search Console gives you for verification.
GOOGLE_SITE_VERIFICATION=

# --- Online ordering (only needed for /order, /checkout and /kitchen) ---------

# Postgres connection string (Neon). Apply migrations with `pnpm db:migrate`.
DATABASE_URL=

# Stripe Checkout. Test keys (sk_test_…) locally; live keys only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The kitchen board's sign-in: a 6–10 digit PIN, and a random secret of at
# least 32 characters that signs the board's session (`openssl rand -hex 32`).
KITCHEN_PIN=
KITCHEN_SECRET=

# Web push for kitchen phones (`npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT="https://7noodles.com"

# Optional: a text message to the kitchen for each new order, through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
KITCHEN_SMS_TO=
